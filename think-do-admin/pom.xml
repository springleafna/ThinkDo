<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.springleaf</groupId>
        <artifactId>think-do-root</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>think-do-admin</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 公共模块 -->
        <dependency>
            <groupId>com.springleaf</groupId>
            <artifactId>think-do-common</artifactId>
        </dependency>

        <!-- 系统模块：用户、权限、认证 -->
        <dependency>
            <groupId>com.springleaf</groupId>
            <artifactId>think-do-system</artifactId>
        </dependency>

        <!-- AI模块：LLM对接、会话管理 -->
        <dependency>
            <groupId>com.springleaf</groupId>
            <artifactId>think-do-ai</artifactId>
        </dependency>

        <!-- 笔记模块 -->
        <dependency>
            <groupId>com.springleaf</groupId>
            <artifactId>think-do-note</artifactId>
        </dependency>

        <!-- 计划模块：包含便签管理 -->
        <dependency>
            <groupId>com.springleaf</groupId>
            <artifactId>think-do-plan</artifactId>
        </dependency>

        <!-- 知识库模块 -->
        <dependency>
            <groupId>com.springleaf</groupId>
            <artifactId>think-do-knowledge</artifactId>
        </dependency>

        <!-- MyBatis Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Sa-Token 权限认证 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
    </dependencies>

</project>
